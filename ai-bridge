"""Stable host CLI launcher; follows the selected release without starting a server."""
import grp
import os
import pwd
from pathlib import Path
import stat
import sys


def private_primary_group(uid, gid):
    """Accept only an enumerated primary group with no other account members."""
    try:
        account = pwd.getpwuid(uid)
        group = grp.getgrgid(gid)
        accounts, groups = pwd.getpwall(), grp.getgrall()
        if account.pw_uid != uid or account.pw_gid != gid or group.gr_gid != gid:
            return False
        if uid == os.geteuid() and (os.getgid() != gid or os.getegid() != gid):
            return False
        if not any(row.pw_name == account.pw_name and row.pw_uid == uid and row.pw_gid == gid for row in accounts):
            return False
        matching = [row for row in groups if row.gr_gid == gid]
        if not matching or group not in matching:
            return False
        return (all(row.pw_name == account.pw_name and row.pw_uid == uid
                    for row in accounts if row.pw_gid == gid) and
                all(name == account.pw_name for row in [group, *matching] for name in row.gr_mem))
    except (KeyError, OSError, RuntimeError):
        return False


def owned(path, directory=True, allow_private_group=False):
    info = path.lstat()
    writable = info.st_mode & 0o022
    if (allow_private_group and directory and info.st_uid == os.geteuid() and
            stat.S_IMODE(info.st_mode) == 0o775 and private_primary_group(os.geteuid(), info.st_gid) and
            not {'system.posix_acl_access', 'system.posix_acl_default'}.intersection(
                os.listxattr(path, follow_symlinks=False))):
        writable = False
    if (info.st_uid != os.geteuid() or writable or
            not (stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode))):
        raise ValueError(f'Unsafe launcher installation path: {path}')


def main():
    launcher = Path(__file__).absolute()
    local = launcher.parent.parent
    if launcher.parent.name != 'bin' or local.name != '.local':
        raise ValueError('Install this launcher with: bash install.sh --install-cli')
    for path in (local.parent, local, launcher.parent):
        owned(path, allow_private_group=True)
    owned(launcher, False)
    root = local / 'share/ai-bridge'
    owned(local / 'share', allow_private_group=True)
    owned(root, allow_private_group=True)
    owned(root / 'releases')
    current = root / 'current'
    if not current.is_symlink() or current.lstat().st_uid not in (os.geteuid(), 0):
        raise ValueError('No service-user/root-owned current release symlink. Select a verified release first.')
    release = current.resolve(strict=True)
    if release.parent != root / 'releases':
        raise ValueError('Current release is outside the owned release directory.')
    for path in (release, release / 'app', release / 'app/ai_bridge', release / 'venv', release / 'venv/bin'):
        owned(path)
    owned(release / 'READY', False)
    owned(release / 'app/ai_bridge/cli.py', False)
    python = release / 'venv/bin/python'
    if not python.is_file() or not os.access(python, os.X_OK):
        raise ValueError('Selected release has no executable Python environment.')
    # Isolated startup ignores caller Python paths; import only the pinned app.
    boot = "import sys; sys.path.insert(0,sys.argv.pop(1)); sys.argv[0]='ai-bridge'; from ai_bridge.cli import main; raise SystemExit(main())"
    args = sys.argv[1:] or ['--help']
    os.execv(str(python), [str(python), '-I', '-c', boot, str(release / 'app'), *args])


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError) as error:
        print(f'ai-bridge: {error}. Reinstall/inspect the CLI from a trusted host terminal; no service was changed.', file=sys.stderr)
        raise SystemExit(1)
